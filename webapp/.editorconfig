# http://editorconfig.org
root = true

[*]
indent_style = tab
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.json]
# Padrão usado pelo bower e pelo npm
indent_style = space
indent_size = 2

[*.yml]
indent_style = space
indent_size = 4
