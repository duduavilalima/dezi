{
	"env": {
		"browser": true,
    "es6": true,
    "amd": true
	},
	"extends": "eslint:recommended",
	"globals": {
		"Atomics": "readonly",
    "SharedArrayBuffer": "readonly",
    "$": "readonly"
  },
  "parser": "babel-eslint",
	"parserOptions": {
		"ecmaVersion": 2018,
    "sourceType": "module"
	},
	"rules": {
		"indent": [
			"error", "tab"
		],
		"linebreak-style": [
			"error", "unix"
		],
		"quotes": [
			"warn", "single"
    ],
    "space-before-function-paren": [
      "off", "never"
    ],
		"semi": [
			"error", "always"
    ],
    "no-console": [
      "warn",
      { "allow": ["error"] }
    ],
    "no-multiple-empty-lines": [
      "error",
      { "max": 1, "maxEOF": 1, "maxBOF": 0 }
    ],
    "max-lines": [
      "error", 3000
    ],
    "max-len": [
      "warn", 160
    ],
    "padding-line-between-statements": [
      "warn",
      { "blankLine": "always", "prev": "block-like", "next": "*" }
    ],
    "padded-blocks": [
      "error", "never"
    ],
    "brace-style": [
      "error", "1tbs",
      { "allowSingleLine": true }
    ],
    "prefer-const": "warn",
    "no-var": "off"
  },
  "overrides": [
    {
      "files": [ "webpack.*" ],
      "env": {
        "node": true
      }
    }
  ]
}
